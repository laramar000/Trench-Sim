<Project Sdk="Microsoft.NET.Sdk">

  <!-- M7.3 verification runner for the Godot client (see docs/client.md, "Automated UI check"). Outside TrenchSim.sln:
       it starts Godot, the server and trench-cli as separate processes and references none of them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>UiCheck</RootNamespace>
  </PropertyGroup>

</Project>
