<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roster builder data (stage 1): the battlekit catalogue format, the keyword vocabulary and the format checks.
       It has no dependencies: Rules.Core never sees names, costs or keywords, only the profiles built from them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Roster</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\content\roster\*.json" Link="content\roster\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\content\roster\factions\*.json" Link="content\roster\factions\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
